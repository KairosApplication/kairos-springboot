<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Constructor injection intentionally retains Spring-managed collaborators. -->
    <Match>
        <Class name="~com\.kairos\.kairosapipostgres\.(controller|service)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.kairos.kairosapipostgres.config.PostgresAuditInitializer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- The filter intentionally shares Spring Session's configured CookieSerializer. -->
    <Match>
        <Class name="com.kairos.kairosapipostgres.config.SessionCookieRenewalFilter"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
