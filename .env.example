# Porta HTTP da API
API_PORT=8080

# Conexão PostgreSQL; substitua pelos dados do seu ambiente.
DB_URL=jdbc:postgresql://SEU_HOST:SUA_PORTA/SEU_BANCO
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

# Apenas para desenvolvimento; defina a estratégia de schema em outros ambientes.
JPA_DDL_AUTO=update

