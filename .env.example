# Porta HTTP da API
API_PORT=8080

# Conexão PostgreSQL; substitua pelos dados do seu ambiente.
DB_URL=jdbc:postgresql://SEU_HOST:SUA_PORTA/SEU_BANCO
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

# Apenas para desenvolvimento; defina a estratégia de schema em outros ambientes.
JPA_DDL_AUTO=update

REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Gere uma chave aleatória de pelo menos 32 bytes e codifique em Base64.
AUTH_SIGNING_KEY=
AUTH_ISSUER=kairos-api
AUTH_AUDIENCE=kairos-clients
AUTH_ACCESS_TTL=15m
AUTH_SESSION_TTL=7d
# false apenas para HTTP local. Em produção, mantenha true e HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s

# API interna de histórico semanal do kairos-data (não é a conexão de autenticação).
KAIROS_REDIS_API_ENABLED=false
KAIROS_REDIS_API_URL=http://localhost:8001
# Use a mesma chave de serviço nos dois backends; nunca enviar ao mobile.
KAIROS_INTERNAL_API_KEY=
KAIROS_REDIS_CONNECT_TIMEOUT=2s
KAIROS_REDIS_READ_TIMEOUT=2s
KAIROS_REDIS_RETRY_DELAY=5000
# Set these only for the first manager bootstrap, then remove them.
# BOOTSTRAP_MANAGER_EMAIL=
# BOOTSTRAP_MANAGER_PASSWORD=
# BOOTSTRAP_MANAGER_CPF=
# BOOTSTRAP_MANAGER_NAME=
# BOOTSTRAP_MANAGER_LAST_NAME=
# BOOTSTRAP_MANAGER_BIRTH_DATE=YYYY-MM-DD
# BOOTSTRAP_MANAGER_ZIP_CODE=
